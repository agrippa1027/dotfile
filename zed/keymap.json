[
  // ============================================================
  //  NORMAL + VISUAL MODE
  // ============================================================
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      // LSP / code actions
      "space m": "editor::ToggleCodeActions",
      "space c a": "editor::ToggleCodeActions",
      "space c f": "editor::Format",
      "space c r": "editor::Rename",
      "g d": "editor::GoToDefinition",
      "space v": "editor::GoToDefinitionSplit",
      "space o i": "editor::OrganizeImports",

      // diagnostics
      "space x x": "diagnostics::Deploy",

      // navigation / pickers
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space f d": [
        "task::Spawn",
        { "task_name": "Dired: Browse Files", "reveal_target": "center" },
      ],
      "space f r": "projects::OpenRecent",
      "space f n": "workspace::NewFile",
      "space ,": "tab_switcher::ToggleAll",
      "ctrl-w space": "file_finder::Toggle",
      "ctrl-w ,": "tab_switcher::ToggleAll",
      "ctrl-[": "pane::ActivatePreviousItem",
      "ctrl-]": "pane::ActivateNextItem",
      "space s s": "outline::Toggle",
      "space s g": "pane::DeploySearch",
      "g r": "editor::FindAllReferences",

      // bookmarks
      "space b m": "editor::ToggleBookmark",
      "space b l": "editor::ViewBookmarks",
      "space b n": "editor::GoToNextBookmark",
      "space b p": "editor::GoToPreviousBookmark",

      // motions
      "shift-l": "vim::EndOfLine",
      "shift-h": "vim::FirstNonWhitespace",
      "v v": "vim::ToggleVisualBlock",
      "v i": "editor::SelectInsideDelimiters",

      // window / panes / terminal
      "space e": "project_panel::ToggleFocus",
      "space g e": "git_panel::ToggleFocus",
      "space E": "workspace::ToggleLeftDock",
      "space p a": "workspace::ToggleRightDock",
      "space -": "pane::SplitDown",
      "space |": "pane::SplitRight",
      "ctrl-w w": "workspace::ActivateNextPane",
      "ctrl-w shift-h": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "left" },
      ],
      "ctrl-w shift-j": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "down" },
      ],
      "ctrl-w shift-k": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "up" },
      ],
      "ctrl-w shift-l": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "right" },
      ],
      "space b d": "pane::CloseActiveItem",
      "space q": "pane::CloseActiveItem",
      "space shift-q": "pane::CloseOtherItems",
      "space t": "workspace::NewCenterTerminal",
      "space shift-l": "workspace::ActivatePaneRight",
      "space shift-h": "workspace::ActivatePaneLeft",

      // comments
      "g c c": "editor::ToggleComments",

      // git
      "space g g": "git_panel::ToggleFocus",
      "g b": "git::Blame",
    },
  },

  // ============================================================
  //  NORMAL MODE ONLY
  // ============================================================
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      // put key-bindings here if you want them to work only in normal mode
      // "down": ["workspace::SendKeystrokes", "4 j"]
      // "up": ["workspace::SendKeystrokes", "4 k"]
    },
  },

  // ============================================================
  //  VISUAL MODE ONLY
  // ============================================================
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      // visual, visual line & visual block modes
      "shift-k": "editor::MoveLineUp",
      "shift-j": "editor::MoveLineDown",
    },
  },

  // ============================================================
  //  PROJECT PANEL (file tree)
  // ============================================================
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "space e": "project_panel::ToggleFocus", // toggle focus back to the editor
      "space space": "file_finder::Toggle",
      "space E": "workspace::ToggleLeftDock",
    },
  },

  // ============================================================
  //  GIT PANEL
  // ============================================================
  {
    "context": "GitPanel && not_editing",
    "bindings": {
      "space g e": "git_panel::ActivateChangesTab", // toggle focus back to the editor
      "space E": "workspace::ToggleLeftDock",
    },
  },

  // ============================================================
  //  NO-BUFFER / WORKSPACE (leader menu when no editor is focused)
  // ============================================================
  {
    // Fires only when no editor is focused (empty pane, dashboard, panels).
    // `!Editor` keeps these from hijacking the spacebar while typing in a buffer.
    "context": "Workspace && !Editor && !menu && !Terminal",
    "bindings": {
      // finders / pickers
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space f d": [
        "task::Spawn",
        { "task_name": "Dired: Browse Files", "reveal_target": "center" },
      ],
      "space f r": "projects::OpenRecent",
      "space f n": "workspace::NewFile",
      "space ,": "tab_switcher::ToggleAll",
      "space s g": "pane::DeploySearch",
      "space x x": "diagnostics::Deploy",

      // panels / docks / terminal
      "space e": "project_panel::ToggleFocus",
      "space g e": "git_panel::ToggleFocus",
      "space g g": "git_panel::ToggleFocus",
      "space E": "workspace::ToggleLeftDock",
      "space p a": "workspace::ToggleRightDock",
      "space t": "workspace::NewCenterTerminal",

      // splits
      "space -": "pane::SplitDown",
      "space |": "pane::SplitRight",
    },
  },

  // ============================================================
  //  PANE TABS (editors + center terminals)
  // ============================================================
  {
    "context": "Pane",
    "bindings": {
      "ctrl-[": "pane::ActivatePreviousItem",
      "ctrl-]": "pane::ActivateNextItem",
    },
  },

  // ============================================================
  //  TERMINAL (center-pane navigation + tab movement)
  // ============================================================
  {
    // Center terminals participate in the same pane navigation as editor tabs.
    "context": "Terminal",
    "bindings": {
      // Ctrl-w is the terminal gateway to workspace commands.
      // Short aliases retained for quick access.
      "ctrl-w space": "file_finder::Toggle",
      "ctrl-w ,": "tab_switcher::ToggleAll",

      // Command palette and mirrors of normal-mode leader bindings.
      "ctrl-w :": "command_palette::Toggle",
      "ctrl-w space space": "file_finder::Toggle",
      "ctrl-w space f f": "file_finder::Toggle",
      "ctrl-w space f r": "projects::OpenRecent",
      "ctrl-w space f n": "workspace::NewFile",
      "ctrl-w space ,": "tab_switcher::ToggleAll",
      "ctrl-w space e": "project_panel::ToggleFocus",

      // Pane navigation.
      "ctrl-w w": "workspace::ActivateNextPane",
      "ctrl-w p": "workspace::ActivatePreviousPane",
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w l": "workspace::ActivatePaneRight",
      "ctrl-w shift-h": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "left" },
      ],
      "ctrl-w shift-j": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "down" },
      ],
      "ctrl-w shift-k": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "up" },
      ],
      "ctrl-w shift-l": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "right" },
      ],
    },
  },

  // ============================================================
  //  INSERT MODE
  // ============================================================
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {
      // put key-bindings here if you want them to work in insert mode
      "j j": "vim::NormalBefore", // remap jj in insert mode to escape.
    },
  },

  // ============================================================
  //  COMPLETION MENU
  // ============================================================
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "tab": "editor::Tab", // indent instead of accepting the completion
      "ctrl-y": "editor::ConfirmCompletion", // accept the selected completion
    },
  },

  // ============================================================
  //  EDIT PREDICTION (AI inline / ghost text)
  // ============================================================
  {
    "context": "Editor && edit_prediction && !showing_completions",
    "bindings": {
      "tab": "editor::Tab", // indent instead of accepting the inline AI suggestion
      "ctrl-y": "editor::AcceptEditPrediction", // accept the inline AI suggestion
    },
  },

  // ============================================================
  //  EDIT PREDICTION — CONFLICT / PREVIEW (hold ⌥ to preview)
  // ============================================================
  {
    // When a prediction conflicts (LSP menu open or leading whitespace) Zed hides it
    // behind ⌥ (hold to preview) and defaults accept to ⌥-tab — which AeroSpace steals
    // for workspace-back-and-forth. Rebind accept to ⌥-y: the ⌥-preview flow stays, but
    // you press y instead of tab.
    "context": "Editor && edit_prediction",
    "bindings": {
      "alt-y": "editor::AcceptEditPrediction",
    },
  },

  // ============================================================
  //  GLOBAL MENUS
  // ============================================================
  {
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
    },
  },

  // ============================================================
  //  EDITOR CONTEXT MENU
  // ============================================================
  {
    "context": "Editor",
    "bindings": {
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuPrevious",
    },
  },


  // ============================================================
  //  MULTI BUFFERS
  // ============================================================
  {
    "context": "Editor && multibuffer",
    "bindings": {
      "ctrl-n": "editor::MoveToStartOfNextExcerpt",
      "ctrl-p": "editor::MoveToStartOfExcerpt",
    },
  },
]
