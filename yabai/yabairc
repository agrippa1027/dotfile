#!/bin/bash
# Hubbamax + mint, with Omarchy-style keys in ~/.config/skhd/skhdrc.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
root="${XDG_CONFIG_HOME:-$HOME/.config}/yabai"

# Feature checks below will expose an unavailable scripting addition.
sudo -n /opt/homebrew/bin/yabai --load-sa || true

# Mission Control must not reorder desktops by recent use.
if [[ "$(/usr/bin/defaults read com.apple.dock mru-spaces 2>/dev/null)" != 0 ]]; then
  /usr/bin/defaults write com.apple.dock mru-spaces -bool false
fi

yabai -m config layout bsp
yabai -m config split_type auto
yabai -m config split_ratio 0.50
yabai -m config auto_balance off
yabai -m config window_placement second_child
yabai -m config window_insertion_point focused
yabai -m config window_zoom_persist on
yabai -m config display_arrangement_order default
yabai -m config mouse_follows_focus on
yabai -m config focus_follows_mouse off
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap

# Reserve the bar height, then leave the same 10px inset as the other window edges.
yabai -m config external_bar all:30:0
yabai -m config top_padding 10
yabai -m config bottom_padding 10
yabai -m config left_padding 10
yabai -m config right_padding 10
yabai -m config window_gap 10
yabai -m config insert_feedback_color 0xff87ffaf

# Focus stays crisp; inactive windows get a subtle fade.
yabai -m config window_opacity on
yabai -m config active_window_opacity 1.0
yabai -m config normal_window_opacity 0.96
yabai -m config window_opacity_duration 0.15
yabai -m config window_shadow float
# CoreVideo display-link animations can deadlock during sleep/display changes.
yabai -m config window_animation_duration 0.0
yabai -m config window_animation_easing ease_out_cubic

"$root/setup-spaces.sh" || exit 1

# Remove only our own definitions when reloading.
for label in browser editor notes books api chat terminal dialogs scratch media-opaque; do
  yabai -m rule --remove "rice-$label" 2>/dev/null || true
done
# Stable labels keep routing correct when native indices change after a move.
yabai -m rule --add label=rice-browser app='^(Firefox|Google Chrome)$' space=ws-1
yabai -m rule --add label=rice-editor app='^Zed$' space=ws-2
yabai -m rule --add label=rice-notes app='^Obsidian$' space=ws-3
yabai -m rule --add label=rice-books app='^calibre$' space=ws-4
yabai -m rule --add label=rice-api app='^(Bruno|bruno)$' space=ws-6
yabai -m rule --add label=rice-chat app='^Discord$' space=ws-7
yabai -m rule --add label=rice-terminal app='^Ghostty$' title!='^Scratchpad$' space=^ws-9
yabai -m rule --add label=rice-dialogs app='^(System Settings|System Preferences|Activity Monitor|Finder|Messages|WhatsApp|Font Book|Raycast|BetterDisplay)$' manage=off
yabai -m rule --add label=rice-scratch app='^Ghostty$' title='^Scratchpad$' manage=off scratchpad=scratch grid=10:10:1:1:8:8 opacity=1.0

# Whole-window fading also fades video content; keep these apps opaque.
yabai -m rule --add label=rice-media-opaque app='^(Firefox|IINA|Stremio|VLC|mpv|QuickTime Player)$' opacity=1.0
yabai -m rule --apply rice-media-opaque

# Workspace labels use app names, not window titles. Remove the old noisy hook on reload.
yabai -m signal --remove rice-window_title_changed 2>/dev/null || true
for event in window_created window_destroyed window_focused window_moved window_minimized window_deminimized space_changed space_created space_destroyed display_changed display_removed display_moved display_resized system_woke mission_control_exit; do
  yabai -m signal --remove "rice-$event" 2>/dev/null || true
  case "$event" in
    space_changed|space_created|space_destroyed|display_removed|display_moved|system_woke|mission_control_exit)
      # shellcheck disable=SC2016
      signal_action='"$HOME/.config/yabai/runtime/order-spaces"; "$HOME/.local/bin/sketchybar" --trigger yabai_workspace_change'
      ;;
    *)
      # shellcheck disable=SC2016
      signal_action='"$HOME/.local/bin/sketchybar" --trigger yabai_workspace_change'
      ;;
  esac
  # Expand HOME when the signal runs.
  yabai -m signal --add label="rice-$event" event="$event" \
    action="$signal_action"
done
yabai -m signal --remove rice-display_added 2>/dev/null || true
# Keep existing monitor assignments after docking, and sort within each display.
# shellcheck disable=SC2016
yabai -m signal --add label=rice-display_added event=display_added \
  action='"$HOME/.config/yabai/setup-spaces.sh"; "$HOME/.local/bin/sketchybar" --trigger yabai_workspace_change'
yabai -m signal --remove rice-dock 2>/dev/null || true
# Expand HOME when the signal runs.
  # shellcheck disable=SC2016
yabai -m signal --add label=rice-dock event=dock_did_restart \
  action='sudo -n /opt/homebrew/bin/yabai --load-sa; "$HOME/.config/yabai/runtime/order-spaces"; "$HOME/.local/bin/sketchybar" --trigger yabai_workspace_change'

"$HOME/.local/bin/sketchybar" --trigger yabai_workspace_change
